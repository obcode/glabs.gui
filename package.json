{
	"name": "glabs.gui",
	"version": "0.0.0",
	"author": "Oliver Braun <oliver.braun@hm.edu>",
	"license": "BSD-3-Clause",
	"private": true,
	"packageManager": "pnpm@11.9.0",
	"type": "module",
	"$comment:imports": "#lib is how src/lib is imported since SvelteKit 3 removed the $lib alias: a Node subpath import, so Vite, TypeScript and Vitest resolve it without any SvelteKit configuration. Imports name the file with its extension (`#lib/format.ts`), because subpath imports map paths and do not search for files.",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "graphql-codegen && vite dev",
		"devhost": "graphql-codegen && vite dev --host",
		"build": "graphql-codegen && vite build",
		"preview": "vite preview",
		"codegen": "graphql-codegen",
		"codegen:watch": "graphql-codegen --watch",
		"schema:pull": "node scripts/pull-schema.mjs",
		"check": "graphql-codegen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "graphql-codegen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@graphql-codegen/cli": "^7.4.6",
		"@graphql-codegen/client-preset": "^6.2.3",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.5",
		"@types/node": "^26.6.6",
		"daisyui": "^5.8.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.2",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"svelte2tsx": "^0.7.63",
		"tailwindcss": "^4.3.5",
		"theme-change": "^3.0.4",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@graphql-typed-document-node/core": "^3.2.0",
		"@sentry/sveltekit": "^10.78.0",
		"ansi-to-html": "^0.7.2",
		"dotenv": "^17.4.2",
		"fflate": "^0.8.3",
		"graphql": "^16.15.0",
		"graphql-request": "^7.4.0",
		"graphql-ws": "^6.4.3"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css,html,md,yaml,yml}": "prettier --write"
	}
}
